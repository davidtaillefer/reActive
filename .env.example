## Example .env (DO NOT commit secrets)
# Database (set DB_HOST=db when using bundled MariaDB service)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=exercise
DB_USER=reactive
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

# Frontend (Vite) API base; set when building the frontend image
VITE_API_BASE_URL=http://localhost:5000/

# Ports
BACKEND_PORT=5000
FRONTEND_PORT=8080

# Host data directory (used as a bind mount in compose)
HOST_BASE_DATA_DIR=/mnt/data
